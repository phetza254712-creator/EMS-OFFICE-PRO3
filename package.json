{
  "name": "ems-office-pro-national",
  "version": "4.0.0",
  "private": true,
  "description": "Local-first EMS shipment records and import assistant for Windows, Android and web",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "node --test",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/core": "6.2.0",
    "mammoth": "1.9.0",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "6.0.1",
    "xlsx": "0.18.5",
    "@capacitor/filesystem": "6.2.0",
    "@capacitor/share": "6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "vite": "6.0.7"
  },
  "build": {
    "appId": "com.bra.emsofficepro",
    "productName": "EMS Office Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "EMS-Office-Pro-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
